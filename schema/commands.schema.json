{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch-spec.dev/schema/commands.schema.json",
  "title": "Batch command language catalog",
  "type": "object",
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cmd_internal_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "True cmd.exe internals (not resolved as separate PATH executables for the verb)"
    },
    "stock_windows_utilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stock Windows PATH/System32 utilities commonly invoked from batch; shadowable via CWD/PATHEXT"
    },
    "builtin_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Union of cmd_internal_commands and stock_windows_utilities for detection"
    },
    "command_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Alias verb mapped to canonical catalog name (shared implementation / help)"
    },
    "common_external_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Common third-party or optional CLIs recognized by tooling, not cmd.exe internals"
    },
    "deprecated_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "removed_commands": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "older_windows_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_command_typos": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "builtin_overlap_deprecated_notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
